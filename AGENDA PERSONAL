import tkinter as tk
from tkinter import ttk, messagebox
from tkcalendar import DateEntry

# MODELO (Single Responsibility)
class Evento:
    def __init__(self, fecha, hora, descripcion):
        self.fecha = fecha
        self.hora = hora
        self.descripcion = descripcion



# LÓGICA (Open/Closed, SRP)

class GestorEventos:
    def __init__(self):
        self.eventos = []

    def agregar_evento(self, evento):
        self.eventos.append(evento)

    def eliminar_evento(self, index):
        if 0 <= index < len(self.eventos):
            del self.eventos[index]

    def obtener_eventos(self):
        return self.eventos

# INTERFAZ (Interface Segregation)
class AgendaGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Agenda Personal")

        self.gestor = GestorEventos()

        self.crear_frames()
        self.crear_componentes()

    # Frames (organización)

    def crear_frames(self):
        self.frame_lista = tk.Frame(self.root)
        self.frame_lista.pack(pady=10)

        self.frame_entrada = tk.Frame(self.root)
        self.frame_entrada.pack(pady=10)

        self.frame_botones = tk.Frame(self.root)
        self.frame_botones.pack(pady=10)


    # Componentes

    def crear_componentes(self):
        # TreeView
        self.tree = ttk.Treeview(self.frame_lista, columns=("Fecha", "Hora", "Descripción"), show="headings")
        self.tree.heading("Fecha", text="Fecha")
        self.tree.heading("Hora", text="Hora")
        self.tree.heading("Descripción", text="Descripción")
        self.tree.pack()

        # Labels y Entradas
        tk.Label(self.frame_entrada, text="Fecha:").grid(row=0, column=0)
        self.fecha_entry = DateEntry(self.frame_entrada)
        self.fecha_entry.grid(row=0, column=1)

        tk.Label(self.frame_entrada, text="Hora:").grid(row=1, column=0)
        self.hora_entry = tk.Entry(self.frame_entrada)
        self.hora_entry.grid(row=1, column=1)

        tk.Label(self.frame_entrada, text="Descripción:").grid(row=2, column=0)
        self.desc_entry = tk.Entry(self.frame_entrada)
        self.desc_entry.grid(row=2, column=1)

        # Botones
        tk.Button(self.frame_botones, text="Agregar Evento", command=self.agregar_evento).grid(row=0, column=0, padx=5)
        tk.Button(self.frame_botones, text="Eliminar Evento", command=self.eliminar_evento).grid(row=0, column=1, padx=5)
        tk.Button(self.frame_botones, text="Salir", command=self.root.quit).grid(row=0, column=2, padx=5)


    # Eventos (Dependency Inversion básico)

    def agregar_evento(self):
        fecha = self.fecha_entry.get()
        hora = self.hora_entry.get()
        descripcion = self.desc_entry.get()

        if not fecha or not hora or not descripcion:
            messagebox.showwarning("Error", "Todos los campos son obligatorios")
            return

        evento = Evento(fecha, hora, descripcion)
        self.gestor.agregar_evento(evento)

        self.actualizar_lista()
        self.limpiar_campos()

    def eliminar_evento(self):
        seleccion = self.tree.selection()
        if not seleccion:
            messagebox.showwarning("Error", "Seleccione un evento")
            return

        confirmar = messagebox.askyesno("Confirmar", "¿Eliminar evento?")
        if confirmar:
            index = self.tree.index(seleccion)
            self.gestor.eliminar_evento(index)
            self.actualizar_lista()


    # Utilidades

    def actualizar_lista(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        for evento in self.gestor.obtener_eventos():
            self.tree.insert("", "end", values=(evento.fecha, evento.hora, evento.descripcion))

    def limpiar_campos(self):
        self.hora_entry.delete(0, tk.END)
        self.desc_entry.delete(0, tk.END)



# MAIN

if __name__ == "__main__":
    root = tk.Tk()
    app = AgendaGUI(root)
    root.mainloop()
